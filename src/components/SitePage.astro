---
import { Image } from 'astro:assets';
import mainWindow from '../assets/main-window.png';
import { locales, type LocaleDefinition } from '../content/locales';
import '../styles/global.css';

interface Props {
  locale: LocaleDefinition;
}

const { locale } = Astro.props;
const { text } = locale;
const releaseUrl = 'https://github.com/a26413768/map_stacker-releases/releases/latest';
const repositoryUrl = 'https://github.com/a26413768/map_stacker-releases';
// Prerelease link. GitHub's /releases/latest resolves to the newest stable
// release, so it never points at a beta. The full releases list shows every
// version newest-first, so the current prerelease sits at the top -- no need
// to hardcode a tag that goes stale on each beta bump.
const betaUrl = `${repositoryUrl}/releases`;
const issuesUrl = `${repositoryUrl}/issues`;
const reportUrl = `${repositoryUrl}/issues/new`;
const base = import.meta.env.BASE_URL;
const localPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const downloadFiles = text.download.platforms.reduce(
  (acc, item) => {
    const file = item.file;
    if (file.includes('windows')) acc.windows = file;
    else if (file.includes('macos-arm64')) acc.macosArm64 = file;
    else if (file.includes('macos-x64')) acc.macosX64 = file;
    else if (file.includes('linux')) acc.linux = file;
    return acc;
  },
  { windows: '', macosArm64: '', macosX64: '', linux: '' },
);

const autoDownloadCopyByLocale = {
  en: {
    title: 'Recommended download for your device',
    detecting: 'Detecting your operating system...',
    unsupported: 'Could not detect a supported desktop operating system. Please choose a package from the table below.',
    recommendedPrefix: 'Detected',
    recommendedSuffix: 'on this device. Recommended package is pre-selected below.',
    fallbackCta: 'Open latest release page',
    ctaPrefix: 'Download',
    manualHint: 'If this is not your target machine, use the table below to choose another package.',
    manualHintActive: 'Need a different package? You can still select one from the table below.',
    osWindows: 'Windows',
    osMacos: 'macOS',
    osLinux: 'Linux',
  },
  'zh-TW': {
    title: '適用於此裝置的建議下載',
    detecting: '正在判別您的作業系統...',
    unsupported: '無法判別受支援的桌面作業系統，請從下方表格手動選擇下載檔案。',
    recommendedPrefix: '已判別目前裝置為',
    recommendedSuffix: '，下方已為您預先選好建議套件。',
    fallbackCta: '開啟最新版本頁面',
    ctaPrefix: '下載',
    manualHint: '若您要下載給其他電腦使用，請改用下方表格手動選擇。',
    manualHintActive: '如果需要其他版本，仍可在下方表格手動選擇。',
    osWindows: 'Windows',
    osMacos: 'macOS',
    osLinux: 'Linux',
  },
  'zh-CN': {
    title: '适用于此设备的推荐下载',
    detecting: '正在识别您的操作系统...',
    unsupported: '无法识别受支持的桌面操作系统，请在下方表格中手动选择安装包。',
    recommendedPrefix: '已识别当前设备为',
    recommendedSuffix: '，下方已为您预选推荐安装包。',
    fallbackCta: '打开最新版本页面',
    ctaPrefix: '下载',
    manualHint: '如果您要下载给其他电脑使用，请在下方表格手动选择。',
    manualHintActive: '如果需要其他版本，仍可在下方表格手动选择。',
    osWindows: 'Windows',
    osMacos: 'macOS',
    osLinux: 'Linux',
  },
  ja: {
    title: 'このデバイス向けの推奨ダウンロード',
    detecting: 'お使いのOSを判定しています...',
    unsupported: '対応するデスクトップOSを判定できませんでした。下の表から手動でパッケージを選択してください。',
    recommendedPrefix: 'このデバイスは',
    recommendedSuffix: 'と判定されました。推奨パッケージを下で選択済みです。',
    fallbackCta: '最新リリースページを開く',
    ctaPrefix: 'ダウンロード',
    manualHint: '別のPC向けにダウンロードする場合は、下の表から手動で選択してください。',
    manualHintActive: '別のパッケージが必要な場合は、下の表から選択できます。',
    osWindows: 'Windows',
    osMacos: 'macOS',
    osLinux: 'Linux',
  },
  de: {
    title: 'Empfohlener Download für dieses Gerät',
    detecting: 'Betriebssystem wird erkannt...',
    unsupported: 'Ein unterstütztes Desktop-Betriebssystem konnte nicht erkannt werden. Bitte wählen Sie ein Paket aus der Tabelle unten.',
    recommendedPrefix: 'Erkanntes System:',
    recommendedSuffix: '. Das empfohlene Paket ist unten vorausgewählt.',
    fallbackCta: 'Seite der neuesten Version öffnen',
    ctaPrefix: 'Download',
    manualHint: 'Falls Sie für einen anderen Rechner herunterladen, wählen Sie unten bitte manuell ein Paket.',
    manualHintActive: 'Sie benötigen ein anderes Paket? Unten können Sie weiterhin manuell wählen.',
    osWindows: 'Windows',
    osMacos: 'macOS',
    osLinux: 'Linux',
  },
  fr: {
    title: 'Téléchargement recommandé pour cet appareil',
    detecting: 'Détection de votre système d’exploitation...',
    unsupported: 'Impossible de détecter un système d’exploitation de bureau pris en charge. Veuillez choisir un paquet dans le tableau ci-dessous.',
    recommendedPrefix: 'Système détecté :',
    recommendedSuffix: '. Le paquet recommandé est pré-sélectionné ci-dessous.',
    fallbackCta: 'Ouvrir la page de la dernière version',
    ctaPrefix: 'Télécharger',
    manualHint: 'Si vous téléchargez pour une autre machine, utilisez le tableau ci-dessous pour choisir manuellement.',
    manualHintActive: 'Besoin d’un autre paquet ? Vous pouvez toujours en choisir un dans le tableau ci-dessous.',
    osWindows: 'Windows',
    osMacos: 'macOS',
    osLinux: 'Linux',
  },
  es: {
    title: 'Descarga recomendada para este dispositivo',
    detecting: 'Detectando su sistema operativo...',
    unsupported: 'No se pudo detectar un sistema operativo de escritorio compatible. Elija un paquete en la tabla de abajo.',
    recommendedPrefix: 'Sistema detectado:',
    recommendedSuffix: '. El paquete recomendado está preseleccionado abajo.',
    fallbackCta: 'Abrir la página de la última versión',
    ctaPrefix: 'Descargar',
    manualHint: 'Si va a descargar para otro equipo, use la tabla de abajo para elegir manualmente.',
    manualHintActive: '¿Necesita otro paquete? Puede elegirlo manualmente en la tabla de abajo.',
    osWindows: 'Windows',
    osMacos: 'macOS',
    osLinux: 'Linux',
  },
  it: {
    title: 'Download consigliato per questo dispositivo',
    detecting: 'Rilevamento del sistema operativo in corso...',
    unsupported: 'Impossibile rilevare un sistema operativo desktop supportato. Seleziona un pacchetto dalla tabella qui sotto.',
    recommendedPrefix: 'Sistema rilevato:',
    recommendedSuffix: '. Il pacchetto consigliato è preselezionato qui sotto.',
    fallbackCta: 'Apri la pagina dell’ultima versione',
    ctaPrefix: 'Scarica',
    manualHint: 'Se stai scaricando per un altro computer, usa la tabella qui sotto per scegliere manualmente.',
    manualHintActive: 'Ti serve un altro pacchetto? Puoi comunque sceglierlo dalla tabella qui sotto.',
    osWindows: 'Windows',
    osMacos: 'macOS',
    osLinux: 'Linux',
  },
} as const;
const autoDownloadCopy = autoDownloadCopyByLocale[locale.code] ?? autoDownloadCopyByLocale.en;
---

<!doctype html>
<html lang={text.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#20252b" />
    <meta name="description" content={text.description} />
    <meta property="og:title" content={text.pageTitle} />
    <meta property="og:description" content={text.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale.ogLocale} />
    <link rel="canonical" href={canonicalUrl} />
    {locales.map((entry) => (
      <link rel="alternate" hreflang={entry.hreflang} href={new URL(localPath(entry.path), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localPath(''), Astro.site)} />
    <link rel="icon" href={localPath('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={localPath('icon.png')} />
    <title>{text.pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-content">
        <a class="brand" href="#top">
          <img src={localPath('icon.png')} alt="" width="42" height="42" />
          <span>MapStacker</span>
        </a>
        <div class="header-navigation">
          <nav aria-label="Main navigation">
            <a href="#features">{text.nav.features}</a>
            <a href="#download">{text.nav.download}</a>
            <a href="#support">{text.nav.support}</a>
            <a href={repositoryUrl}>GitHub</a>
          </nav>
          <details class="language-menu">
            <summary aria-label={text.languageLabel}>{locale.name}</summary>
            <ul>
              {locales.map((entry) => (
                <li>
                  {entry.code === locale.code ? (
                    <span aria-current="page">{entry.name}</span>
                  ) : (
                    <a href={localPath(entry.path)} hreflang={entry.hreflang}>{entry.name}</a>
                  )}
                </li>
              ))}
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="intro content-width">
        <div class="intro-text">
          <h1>MapStacker</h1>
          <p class="summary">{text.intro.summary}</p>
          <p>{text.intro.details}</p>
          <div class="intro-actions">
            <a class="primary-link" href="#download">{text.intro.download}</a>
            <a href={releaseUrl}>{text.intro.latestRelease}</a>
            <a href={betaUrl}>{text.intro.beta}</a>
          </div>
          <p class="availability">{text.intro.availability}</p>
        </div>
        <img class="app-icon" src={localPath('icon.png')} alt="MapStacker" width="180" height="180" />
      </section>

      <section class="screenshot content-width" aria-labelledby="screenshot-title">
        <h2 id="screenshot-title">{text.screenshot.title}</h2>
        <figure>
          <div class="screenshot-frame">
            <Image
              class="application-screenshot"
              src={mainWindow}
              alt={text.screenshot.alt}
              widths={[780, 1200, 1560, 1850]}
              sizes="(max-width: 900px) 94vw, 1080px"
              loading="eager"
            />
          </div>
          <figcaption>{text.screenshot.caption}</figcaption>
        </figure>
      </section>

      <section class="content-section content-width" id="features">
        <h2>{text.features.title}</h2>
        <div class="two-columns">
          <div>
            {text.features.groups.slice(0, 2).map((group) => (
              <section class="feature-group">
                <h3>{group.title}</h3>
                <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
              </section>
            ))}
          </div>
          <div>
            {text.features.groups.slice(2).map((group) => (
              <section class="feature-group">
                <h3>{group.title}</h3>
                <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section class="content-section content-width">
        <h2>{text.workflow.title}</h2>
        <ol class="workflow-list">
          {text.workflow.steps.map((step) => (
            <li><strong>{step.title}</strong> {step.text}</li>
          ))}
        </ol>
      </section>

      <section class="content-section content-width" id="download">
        <div class="section-title-row">
          <div>
            <h2>{text.download.title}</h2>
            <p>{text.download.intro}</p>
          </div>
          <a href={releaseUrl}>{text.download.releaseNotes}</a>
        </div>

        <section
          class="auto-download-card"
          id="auto-download-card"
          aria-live="polite"
          data-release-url={releaseUrl}
          data-windows-file={downloadFiles.windows}
          data-macos-arm64-file={downloadFiles.macosArm64}
          data-macos-x64-file={downloadFiles.macosX64}
          data-linux-file={downloadFiles.linux}
          data-detecting={autoDownloadCopy.detecting}
          data-unsupported={autoDownloadCopy.unsupported}
          data-recommended-prefix={autoDownloadCopy.recommendedPrefix}
          data-recommended-suffix={autoDownloadCopy.recommendedSuffix}
          data-fallback-cta={autoDownloadCopy.fallbackCta}
          data-cta-prefix={autoDownloadCopy.ctaPrefix}
          data-manual-hint={autoDownloadCopy.manualHint}
          data-manual-hint-active={autoDownloadCopy.manualHintActive}
          data-os-windows={autoDownloadCopy.osWindows}
          data-os-macos={autoDownloadCopy.osMacos}
          data-os-linux={autoDownloadCopy.osLinux}
        >
          <h3>{autoDownloadCopy.title}</h3>
          <p class="auto-download-status" data-role="status">{autoDownloadCopy.detecting}</p>
          <a class="primary-link auto-download-link is-disabled" data-role="cta" href={releaseUrl} aria-disabled="true">
            {autoDownloadCopy.fallbackCta}
          </a>
          <p class="auto-download-hint" data-role="hint">{autoDownloadCopy.manualHint}</p>
        </section>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>{text.download.columns.platform}</th>
                <th>{text.download.columns.requirements}</th>
                <th>{text.download.columns.package}</th>
                <th>{text.download.columns.notes}</th>
              </tr>
            </thead>
            <tbody>
              {text.download.platforms.map((download) => (
                <tr>
                  <td><strong>{download.platform}</strong></td>
                  <td>{download.requirements}</td>
                  <td><a href={`${releaseUrl}/download/${download.file}`}>{download.file}</a></td>
                  <td>{download.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="download-note">
          {text.download.archiveNoteBefore} <code>{text.download.archiveNoteChecksum}</code> {text.download.archiveNoteAfter}
        </p>
      </section>

      <section class="content-section content-width" id="support">
        <h2>{text.support.title}</h2>
        <p>{text.support.paragraph1}</p>
        <p>{text.support.paragraph2}</p>
        <div class="support-links">
          <a class="primary-link" href={reportUrl}>{text.support.newIssue}</a>
          <a href={issuesUrl}>{text.support.browseIssues}</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="content-width footer-content">
        <span>MapStacker</span>
        <nav aria-label="Footer navigation">
          <a href={repositoryUrl}>GitHub</a>
          <a href={releaseUrl}>{text.footer.releases}</a>
          <a href={issuesUrl}>{text.footer.issues}</a>
        </nav>
        <small>© 2026 a26413768</small>
      </div>
    </footer>

    <script is:inline>
      (async () => {
        const card = document.getElementById('auto-download-card');
        if (!card) return;

        const status = card.querySelector('[data-role="status"]');
        const cta = card.querySelector('[data-role="cta"]');
        const hint = card.querySelector('[data-role="hint"]');
        if (!status || !cta || !hint) return;

        const releaseUrl = card.dataset.releaseUrl || '';
        const files = {
          windows: card.dataset.windowsFile || '',
          macosArm64: card.dataset.macosArm64File || '',
          macosX64: card.dataset.macosX64File || '',
          linux: card.dataset.linuxFile || '',
        };
        const osLabels = {
          windows: card.dataset.osWindows || 'Windows',
          macos: card.dataset.osMacos || 'macOS',
          linux: card.dataset.osLinux || 'Linux',
        };

        const detectOS = () => {
          const ua = navigator.userAgent.toLowerCase();
          const platform = (
            (navigator.userAgentData && navigator.userAgentData.platform) ||
            navigator.platform ||
            ''
          ).toLowerCase();

          if (platform.includes('win') || ua.includes('windows')) return 'windows';
          if (platform.includes('mac') || platform.includes('darwin') || ua.includes('mac os')) return 'macos';
          if (platform.includes('linux') || ua.includes('linux') || ua.includes('x11')) return 'linux';
          return null;
        };

        const resolveMacFile = async () => {
          // Browsers can't reliably report the Mac CPU architecture
          // synchronously. Prefer the native arm64 build when the architecture
          // hint reports Apple Silicon; otherwise fall back to the x64 build,
          // which runs on Intel Macs natively and on Apple Silicon via Rosetta.
          try {
            const uaData = navigator.userAgentData;
            if (uaData && uaData.getHighEntropyValues) {
              const hints = await uaData.getHighEntropyValues(['architecture']);
              if (hints && hints.architecture === 'arm' && files.macosArm64) return files.macosArm64;
            }
          } catch (err) {}
          return files.macosX64 || files.macosArm64;
        };

        const resolveFile = (os) =>
          os === 'macos' ? resolveMacFile() : Promise.resolve(files[os] || '');

        const os = detectOS();
        const file = os ? await resolveFile(os) : '';
        if (!os || !file) {
          status.textContent = card.dataset.unsupported || '';
          cta.textContent = card.dataset.fallbackCta || '';
          cta.setAttribute('href', releaseUrl);
          cta.setAttribute('aria-disabled', 'true');
          cta.classList.add('is-disabled');
          hint.textContent = card.dataset.manualHint || '';
          return;
        }

        status.textContent = `${card.dataset.recommendedPrefix || ''} ${osLabels[os]}${card.dataset.recommendedSuffix || ''}`;
        cta.textContent = `${card.dataset.ctaPrefix || 'Download'} ${file}`;
        cta.setAttribute('href', `${releaseUrl}/download/${file}`);
        cta.removeAttribute('aria-disabled');
        cta.classList.remove('is-disabled');
        hint.textContent = card.dataset.manualHintActive || '';
      })();
    </script>
  </body>
</html>
