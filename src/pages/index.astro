---
import { Image } from 'astro:assets';
import mainWindow from '../assets/main-window.png';
import '../styles/global.css';

const releaseUrl = 'https://github.com/a26413768/map_stacker-releases/releases/latest';
const repositoryUrl = 'https://github.com/a26413768/map_stacker-releases';
const issuesUrl = `${repositoryUrl}/issues`;
const reportUrl = `${repositoryUrl}/issues/new`;
const base = import.meta.env.BASE_URL;

const downloads = [
  {
    platform: 'Windows',
    requirements: 'Windows 10 or 11 (64-bit)',
    file: 'MapStacker-windows-x64.zip',
    notes: 'Unzip the archive and run MapStacker.exe.',
  },
  {
    platform: 'macOS',
    requirements: 'Apple Silicon (arm64)',
    file: 'MapStacker-macos-arm64.zip',
    notes: 'Unsigned application. On first launch, right-click and choose Open.',
  },
  {
    platform: 'Linux',
    requirements: 'x64, glibc 2.31 or newer',
    file: 'MapStacker-linux-x64.zip',
    notes: 'Requires a graphical X11 environment with Qt xcb support.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#20252b" />
    <meta
      name="description"
      content="MapStacker is a desktop application for stacking lunar and planetary SER image sequences."
    />
    <meta property="og:title" content="MapStacker" />
    <meta
      property="og:description"
      content="Desktop software for stacking lunar and planetary SER image sequences."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}icon.png`} />
    <title>MapStacker</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-content">
        <a class="brand" href="#top">
          <img src={`${base}icon.png`} alt="" width="42" height="42" />
          <span>MapStacker</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#features">Features</a>
          <a href="#download">Download</a>
          <a href="#support">Support</a>
          <a href={repositoryUrl}>GitHub</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="intro content-width">
        <div class="intro-text">
          <h1>MapStacker</h1>
          <p class="summary">
            MapStacker is a desktop application for stacking monochrome and colour
            lunar or planetary image sequences stored in SER files.
          </p>
          <p>
            It provides frame quality analysis, global stabilization, multiple
            alignment points, local frame selection, mesh-based stacking, Drizzle,
            colour alignment, and 16-bit TIFF output.
          </p>
          <div class="intro-actions">
            <a class="primary-link" href="#download">Download MapStacker</a>
            <a href={releaseUrl}>View the latest release</a>
          </div>
          <p class="availability">
            Available for Windows, macOS, and Linux. English and Traditional Chinese
            interfaces are included.
          </p>
        </div>
        <img class="app-icon" src={`${base}icon.png`} alt="MapStacker application icon" width="180" height="180" />
      </section>

      <section class="screenshot content-width" aria-labelledby="screenshot-title">
        <h2 id="screenshot-title">Application window</h2>
        <figure>
          <div class="screenshot-frame">
            <Image
              class="application-screenshot"
              src={mainWindow}
              alt="MapStacker main window displaying a lunar image and its alignment points"
              widths={[780, 1200, 1560, 1850]}
              sizes="(max-width: 900px) 94vw, 1080px"
              loading="eager"
            />
          </div>
          <figcaption>
            The main window contains processing controls, frame navigation, alignment
            points, and an image preview.
          </figcaption>
        </figure>
      </section>

      <section class="content-section content-width" id="features">
        <h2>Features</h2>
        <div class="two-columns">
          <div>
            <h3>Input and frame selection</h3>
            <ul>
              <li>Monochrome, RGB, and Bayer CFA SER input</li>
              <li>Frame quality ranking before image resampling</li>
              <li>Manual frame exclusion and reference-frame selection</li>
              <li>Independent local frame selection for each alignment point</li>
            </ul>

            <h3>Alignment</h3>
            <ul>
              <li>Global frame stabilization using phase correlation or centre of gravity</li>
              <li>Automatic alignment-point placement using a centroidal Voronoi grid</li>
              <li>Sub-pixel local alignment with outlier handling</li>
            </ul>
          </div>
          <div>
            <h3>Stacking and colour</h3>
            <ul>
              <li>Piecewise affine mesh stacking</li>
              <li>Drizzle processing for monochrome, RGB, and Bayer data</li>
              <li>Several global and local RGB alignment methods</li>
              <li>Batch processing of SER files in a folder</li>
            </ul>

            <h3>Output</h3>
            <ul>
              <li>Automatic cropping and optional output centring</li>
              <li>16-bit TIFF output</li>
              <li>Text sidecar with settings, source metadata, frame selection, and alignment points</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="content-section content-width">
        <h2>Typical workflow</h2>
        <ol class="workflow-list">
          <li><strong>Open a SER file.</strong> MapStacker reads the capture and its metadata.</li>
          <li><strong>Analyse frame quality.</strong> Review the ranking and exclude unsuitable frames if needed.</li>
          <li><strong>Stabilize the sequence.</strong> Estimate and correct global movement.</li>
          <li><strong>Place alignment points.</strong> Use automatic placement or adjust the points manually.</li>
          <li><strong>Run the stack.</strong> Choose the frame percentages, stacking method, and colour options.</li>
          <li><strong>Export the result.</strong> Save the image as a 16-bit TIFF with its processing record.</li>
        </ol>
      </section>

      <section class="content-section content-width" id="download">
        <div class="section-title-row">
          <div>
            <h2>Download</h2>
            <p>Pre-built packages do not require a Python installation.</p>
          </div>
          <a href={releaseUrl}>Release notes and checksums</a>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Platform</th>
                <th>Requirements</th>
                <th>Package</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              {downloads.map((download) => (
                <tr>
                  <td><strong>{download.platform}</strong></td>
                  <td>{download.requirements}</td>
                  <td>
                    <a href={`${releaseUrl}/download/${download.file}`}>{download.file}</a>
                  </td>
                  <td>{download.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="download-note">
          The packages are distributed as ZIP archives. Download the corresponding
          <code>.sha256</code> file from the release page if you want to verify the archive.
        </p>
      </section>

      <section class="content-section content-width" id="support">
        <h2>Support and issue reports</h2>
        <p>
          Bug reports and feature requests are managed through GitHub Issues. Before
          opening a report, please check whether the same problem has already been reported.
        </p>
        <p>
          A useful bug report should include the MapStacker version, operating system,
          steps needed to reproduce the problem, and any relevant screenshot or log.
        </p>
        <div class="support-links">
          <a class="primary-link" href={reportUrl}>Open a new issue</a>
          <a href={issuesUrl}>Browse existing issues</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="content-width footer-content">
        <span>MapStacker</span>
        <nav aria-label="Footer navigation">
          <a href={repositoryUrl}>GitHub</a>
          <a href={releaseUrl}>Releases</a>
          <a href={issuesUrl}>Issues</a>
        </nav>
        <small>© 2026 a26413768</small>
      </div>
    </footer>
  </body>
</html>
